{
  "env": {
    "GH_TELEMETRY": "false"
  },
  "mcpServers": {
    "sem": {
      "command": "sem",
      "args": ["mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "statusMessage": "Provisioning dev tools…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/tools/.claude/auto-pr.sh",
            "statusMessage": "Creating pull request…",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
